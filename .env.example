# Pflicht: dein Anthropic API-Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ORTFINDER_MODEL=claude-opus-5
# ORTFINDER_EFFORT=high            # low | medium | high | xhigh | max
# ORTFINDER_MAX_STEPS=30           # maximale Agenten-Runden pro Bild
# ORTFINDER_WEB_SEARCH=1           # 0 = Websuche aus
# ORTFINDER_WEB_SEARCH_MAX_USES=10
# ORTFINDER_CONTACT=you@example.com  # wird im User-Agent an OpenStreetMap geschickt (Nominatim-Richtlinie)
